---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const hasImages = project.gallery.length > 0;
---

<BaseLayout
  title={`${project.title} | Pouria Alaei`}
  description={project.subtitle}
>
  <main>
    <section class="hero">
      <div class="page">
        <a class="back" href="/projects">← All projects</a>

        <p class="eyebrow">{project.projectType}</p>
        <h1>{project.title}</h1>
        <p class="lead">{project.subtitle}</p>

        <div class="hero-meta">
          <div>
            <span>Organization</span>
            <strong>{project.organization}</strong>
          </div>
          <div>
            <span>Period</span>
            <strong>{project.period}</strong>
          </div>
          {project.headlineMetric && (
            <div>
              <span>Headline result</span>
              <strong>{project.headlineMetric}</strong>
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="project-nav">
      <div class="page tags">
        {project.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </section>

    <section class="content-band">
      <div class="page two-column">
        <div>
          <p class="section-label">Overview</p>
          <h2>The product and its context</h2>
        </div>
        <p class="body-large">{project.summary}</p>
      </div>
    </section>

    <section class="content-band">
      <div class="page two-column">
        <div>
          <p class="section-label">Engineering challenge</p>
          <h2>Constraints that shaped the work</h2>
        </div>
        <p class="body-large">{project.problem}</p>
      </div>
    </section>

    <section class="content-band">
      <div class="page two-column">
        <div>
          <p class="section-label">My role</p>
          <h2>Scope and ownership</h2>
        </div>
        <p class="body-large">{project.role}</p>
      </div>
    </section>

    <section class="content-band">
      <div class="page two-column">
        <div>
          <p class="section-label">Implementation</p>
          <h2>Key engineering work</h2>
        </div>
        <ol class="work-list">
          {project.keyWork.map((item) => <li>{item}</li>)}
        </ol>
      </div>
    </section>

    <section class="results-band">
      <div class="page">
        <p class="section-label">Results</p>
        <h2>What changed because of the work</h2>
        <div class="results-grid">
          {project.outcomes.map((outcome) => (
            <article>
              <span aria-hidden="true">✓</span>
              <p>{outcome}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="content-band">
      <div class="page two-column">
        <div>
          <p class="section-label">Evidence of capability</p>
          <h2>What this project demonstrates</h2>
        </div>
        <ul class="capability-list">
          {project.capabilities.map((capability) => <li>{capability}</li>)}
        </ul>
      </div>
    </section>

    {hasImages && (
      <section class="content-band">
        <div class="page">
          <p class="section-label">Visual evidence</p>
          <h2>Hardware, interfaces, and deployment</h2>
          <div class="gallery">
            {project.gallery.map((image) => (
              <img src={image} alt={`${project.title} project evidence`} loading="lazy" />
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="confidentiality">
      <div class="page">
        <strong>Confidentiality</strong>
        <p>{project.confidentialityNote}</p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    padding: 64px 0 48px;
  }

  .back {
    display: inline-block;
    margin-bottom: 48px;
    color: #67e8f9;
    text-decoration: none;
    font-weight: 700;
  }

  .eyebrow,
  .section-label {
    margin: 0;
    color: #67e8f9;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    max-width: 920px;
    margin: 12px 0 0;
    font-size: clamp(40px, 7vw, 72px);
    line-height: 1.05;
  }

  .lead {
    max-width: 880px;
    margin: 22px 0 0;
    color: #cbd5e1;
    font-size: 20px;
    line-height: 1.7;
  }

  .hero-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 44px;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 8px;
    background: rgba(148, 163, 184, 0.22);
  }

  .hero-meta div {
    min-height: 112px;
    padding: 20px;
    background: #0b1425;
  }

  .hero-meta span,
  .hero-meta strong {
    display: block;
  }

  .hero-meta span {
    margin-bottom: 10px;
    color: #94a3b8;
    font-size: 13px;
  }

  .hero-meta strong {
    color: #e5eef7;
    line-height: 1.45;
  }

  .project-nav {
    padding: 20px 0;
    border-top: 1px solid rgba(148, 163, 184, 0.18);
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(15, 23, 42, 0.55);
  }

  .content-band,
  .results-band {
    padding: 64px 0;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  }

  .two-column {
    display: grid;
    grid-template-columns: minmax(220px, 0.7fr) minmax(0, 1.3fr);
    gap: 64px;
    align-items: start;
  }

  h2 {
    margin: 10px 0 0;
    color: #e5eef7;
    font-size: 28px;
    line-height: 1.2;
  }

  .body-large {
    margin: 0;
    color: #cbd5e1;
    font-size: 18px;
    line-height: 1.8;
  }

  .work-list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: work;
  }

  .work-list li {
    counter-increment: work;
    position: relative;
    padding: 0 0 22px 48px;
    color: #cbd5e1;
    line-height: 1.7;
  }

  .work-list li::before {
    content: counter(work, decimal-leading-zero);
    position: absolute;
    top: 0;
    left: 0;
    color: #67e8f9;
    font-size: 13px;
    font-weight: 800;
  }

  .results-band {
    background: rgba(15, 23, 42, 0.52);
  }

  .results-band h2 {
    max-width: 720px;
  }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 32px;
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 8px;
    overflow: hidden;
    background: rgba(148, 163, 184, 0.22);
  }

  .results-grid article {
    min-height: 150px;
    padding: 24px;
    background: #0b1425;
  }

  .results-grid span {
    color: #67e8f9;
    font-weight: 900;
  }

  .results-grid p {
    margin: 14px 0 0;
    color: #e5eef7;
    line-height: 1.65;
  }

  .capability-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .capability-list li {
    padding: 14px 16px;
    border-left: 3px solid #67e8f9;
    background: rgba(15, 23, 42, 0.6);
    color: #e5eef7;
    font-weight: 700;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 28px;
  }

  .gallery img {
    width: 100%;
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 8px;
  }

  .confidentiality {
    padding: 28px 0 72px;
  }

  .confidentiality .page {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 24px;
    padding-top: 24px;
  }

  .confidentiality strong {
    color: #93c5fd;
  }

  .confidentiality p {
    margin: 0;
    color: #94a3b8;
    line-height: 1.7;
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 44px;
    }

    .back {
      margin-bottom: 36px;
    }

    .hero-meta,
    .two-column,
    .results-grid,
    .capability-list,
    .gallery,
    .confidentiality .page {
      grid-template-columns: 1fr;
    }

    .two-column {
      gap: 28px;
    }

    .content-band,
    .results-band {
      padding: 48px 0;
    }
  }
</style>
