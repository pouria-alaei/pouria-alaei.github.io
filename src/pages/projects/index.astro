---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";
import { site } from "../../data/site";

const projectCount = projects.length;

const focusAreas = [
  "Linux platforms and BSP",
  "C/C++ device software",
  "RTOS and bare-metal firmware",
  "Board bring-up",
  "Industrial networking",
  "Testing and release engineering",
  "Edge AI",
];
---

<BaseLayout
  title={`Projects | ${site.name}`}
  description={`Selected embedded systems, Embedded Linux, Edge AI, and hardware/software integration projects by ${site.name}.`}
>
  <main class="page">
    <section class="section intro">
      <p class="eyebrow">Selected Work</p>
      <h1>Embedded systems, built across the full stack.</h1>

      <p class="lead">
        These case studies expand the short claims in my resume into engineering
        context: the constraints I worked within, the decisions and integrations I
        owned, the measurable outcomes, and the capabilities each project demonstrates.
      </p>

      <div class="stats">
        <div class="stat-card">
          <strong>{projectCount}</strong>
          <span>Engineering case studies</span>
        </div>

        <div class="stat-card">
          <strong>7+ years</strong>
          <span>Embedded product development</span>
        </div>

        <div class="stat-card">
          <strong>Linux to MCU</strong>
          <span>Cross-layer engineering</span>
        </div>
      </div>
    </section>

    <section class="section compact">
      <h2 class="section-title">Focus Areas</h2>

      <div class="tags">
        {focusAreas.map((area) => <span>{area}</span>)}
      </div>
    </section>

    <section class="projects-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .intro {
    padding-bottom: 32px;
  }

  .compact {
    padding-top: 24px;
    padding-bottom: 40px;
  }

  .eyebrow {
    color: #67e8f9;
    font-weight: 700;
    letter-spacing: 0;
  }

  h1 {
    max-width: 980px;
    margin: 12px 0 0;
    font-size: clamp(42px, 7vw, 72px);
    line-height: 1.05;
  }

  .lead {
    max-width: 840px;
    color: #cbd5e1;
    font-size: 20px;
    line-height: 1.7;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px;
    margin-top: 32px;
  }

  .stat-card {
    border: 1px solid rgba(148, 163, 184, 0.22);
    background: rgba(15, 23, 42, 0.62);
    border-radius: 8px;
    padding: 18px;
  }

  .stat-card strong {
    display: block;
    color: #67e8f9;
    font-size: 24px;
    margin-bottom: 6px;
  }

  .stat-card span {
    color: #cbd5e1;
    font-weight: 600;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    padding-bottom: 80px;
  }

</style>
