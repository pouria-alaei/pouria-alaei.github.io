---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title={`About | ${site.name}`}
  description={`About ${site.name}, an Embedded Software Engineer with 7+ years of experience in Embedded Linux, firmware, and hardware/software integration.`}
>
  <main class="page">
    <section class="section intro">
      <div class="intro-copy">
        <p class="eyebrow">About</p>
        <h1>Engineering embedded products from hardware to software.</h1>

        <p class="lead">
          I am an Embedded Software Engineer with 7+ years of experience building
          production systems across electronics, firmware, Embedded Linux, user
          interfaces, networking, validation, and intelligent edge applications.
        </p>
      </div>

      <figure class="portrait">
        <img
          src="/images/profile/pouria-alaei.jpeg"
          alt="Portrait of Pouria Alaei"
          width="800"
          height="800"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="content-grid">
      <article class="card">
        <h2>Engineering Profile</h2>
        <p>
          My work spans ARM Linux platforms, BSP and board bring-up, bare-metal and
          RTOS firmware, device-control services, connectivity, UI integration, and
          production validation. I am most effective on problems that cross hardware,
          kernel, user space, services, and product behavior.
        </p>
      </article>

      <article class="card">
        <h2>Core Strengths</h2>
        <p>
          I work hands-on with C/C++, Buildroot, Yocto, OpenWrt, Zephyr RTOS,
          STM32/ESP32, Qt/LVGL, Linux networking, MQTT, cellular communication,
          hardware bring-up, and cross-layer debugging on real products.
        </p>
      </article>

      <article class="card">
        <h2>Edge AI and Robotics Background</h2>
        <p>
          With an academic background in Electrical Engineering, AI, and Robotics,
          I am especially interested in edge AI systems, intelligent devices,
          computer vision applications, and practical embedded platforms that bring
          intelligence closer to the hardware.
        </p>
      </article>

      <article class="card">
        <h2>Technical Ownership and Delivery</h2>
        <p>
          I turn product requirements into system boundaries, coordinate interfaces
          across hardware, embedded services, UI, backend, and validation, and improve
          delivery through automated tests and repeatable CI/CD releases. My focus is
          moving embedded products from prototype risk to maintainable operation.
        </p>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .eyebrow {
    color: #67e8f9;
    font-weight: 700;
    letter-spacing: 0;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    gap: 56px;
    align-items: center;
  }

  h1 {
    max-width: 980px;
    margin: 12px 0 0;
    font-size: clamp(42px, 7vw, 72px);
    line-height: 1.05;
  }

  .lead {
    max-width: 820px;
    color: #cbd5e1;
    font-size: 20px;
    line-height: 1.7;
  }

  .portrait {
    margin: 0;
  }

  .portrait img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid rgba(148, 163, 184, 0.28);
    border-radius: 8px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.32);
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
    padding-bottom: 80px;
  }

  h2 {
    margin-top: 0;
    color: #93c5fd;
  }

  p {
    color: #cbd5e1;
    line-height: 1.7;
  }

  @media (max-width: 760px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .portrait {
      order: -1;
      width: min(100%, 320px);
    }
  }
</style>
