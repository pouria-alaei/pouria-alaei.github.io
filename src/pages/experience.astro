---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title={`Experience | ${site.name}`}
  description={`Professional experience of ${site.name} across Embedded Linux, firmware, industrial connectivity, Edge AI, and hardware/software integration.`}
>
  <main class="page">
    <section class="section intro">
      <p class="eyebrow">Experience</p>
      <h1>Seven years across Linux platforms, firmware, and production hardware.</h1>

      <p class="lead">
        My career has progressed from low-level firmware, custom-board bring-up, and
        industrial control to ownership of Linux product platforms, cross-team
        integration, automated validation, and repeatable releases.
      </p>
    </section>

    <section class="timeline">
      <article class="role">
        <div class="role-meta">
          <p class="date">Jan 2024 - Present</p>
          <p>Zarrin Samane Shargh</p>
        </div>
        <div class="role-content">
          <h2>Embedded Linux Engineer</h2>
          <p>
            Build and validate Linux platforms for connected conference, audio/video,
            industrial connectivity, vending, and telemetry products. Coordinate
            interfaces across hardware, embedded services, UI, backend, and validation.
          </p>
          <ul>
            <li>Modernized an STM32 conference product to ARM Linux in 6 months, enabling up to 10x higher processing capacity.</li>
            <li>Delivered a roughly 90 MB Buildroot platform with U-Boot, kernel, RootFS, systemd, and Qt.</li>
            <li>Built OpenWrt firmware for an HLK-7628 industrial LTE/Wi-Fi modem and router.</li>
            <li>Validated 12 critical audio, video, UI, networking, display, and peripheral workflows.</li>
            <li>Created tests with a 90%+ QA pass rate and reduced manual release effort by 30-40% through GitLab CI/CD.</li>
          </ul>
        </div>
      </article>

      <article class="role">
        <div class="role-meta">
          <p class="date">May 2019 - Jan 2024</p>
          <p>Pilotech / Kimia Electronic</p>
        </div>
        <div class="role-content">
          <h2>Embedded Software Engineer</h2>
          <p>
            Developed firmware, Linux systems, and hardware/software integrations for
            industrial and commercial embedded products in an R&D-focused OEM/ODM
            environment.
          </p>
          <ul>
            <li>Developed C/C++ firmware for appliance and industrial control boards using motors, relays, sensors, and fault handling.</li>
            <li>Designed Zephyr RTOS firmware for an STM32F429 generator controller with a 1 ms task budget.</li>
            <li>Fit a Yocto Linux and LVGL product image into approximately 60 MB of NAND on Allwinner T113.</li>
            <li>Resolved more than 15 pre-production hardware issues during custom-board bring-up.</li>
            <li>Built Edge AI vision pipelines with more than 80% detection accuracy on resource-limited hardware.</li>
          </ul>
        </div>
      </article>
    </section>

    <section class="education">
      <div>
        <p class="eyebrow">Education</p>
        <h2>M.Sc. Artificial Intelligence and Robotics</h2>
        <p>Isfahan University of Technology</p>
      </div>
      <div>
        <p class="eyebrow">Foundation</p>
        <h2>B.Sc. Electrical Engineering, Telecommunications</h2>
        <p>Shahrood University of Technology</p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .eyebrow,
  .date {
    color: #67e8f9;
    font-weight: 700;
    letter-spacing: 0;
  }

  h1 {
    max-width: 980px;
    margin: 12px 0 0;
    font-size: clamp(42px, 7vw, 72px);
    line-height: 1.05;
  }

  .lead {
    max-width: 840px;
    color: #cbd5e1;
    font-size: 20px;
    line-height: 1.7;
  }

  .timeline {
    border-top: 1px solid rgba(148, 163, 184, 0.22);
  }

  .role {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 56px;
    padding: 48px 0;
    border-bottom: 1px solid rgba(148, 163, 184, 0.22);
  }

  .role-meta p {
    margin: 0 0 8px;
    color: #94a3b8;
  }

  .role-meta .date {
    color: #67e8f9;
  }

  h2 {
    margin: 0;
    color: #e5eef7;
    line-height: 1.25;
  }

  .role-content > p,
  li,
  .education p {
    color: #cbd5e1;
    line-height: 1.7;
  }

  ul {
    margin: 24px 0 0;
    padding-left: 20px;
  }

  li + li {
    margin-top: 10px;
  }

  .education {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    padding: 64px 0 80px;
  }

  .education .eyebrow {
    margin-bottom: 12px;
  }

  @media (max-width: 760px) {
    .role,
    .education {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .role {
      padding: 40px 0;
    }
  }
</style>
